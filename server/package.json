{
  "name": "diary-server",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js backend of 'Your Personal Diary': the hosted server of the Windows and Android apps and the website (DIARY_MODE=hosted, Fly.io), and the local mode for development and tests. No telemetry.",
  "type": "module",
  "main": "dist/server.cjs",
  "scripts": {
    "dev": "tsx watch src/index.ts --data-dir ./.dev-data --port 47321 --dev",
    "start": "tsx src/index.ts --data-dir ./.dev-data --port 47321",
    "build": "node ../scripts/build-server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bidi-js": "^1.0.3",
    "express": "^5.1.0",
    "pdfkit": "^0.17.1",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.0",
    "@types/sql.js": "^1.4.9",
    "esbuild": "^0.25.0",
    "supertest": "^7.1.0",
    "@types/supertest": "^6.0.3",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vitest": "^3.2.0"
  }
}
