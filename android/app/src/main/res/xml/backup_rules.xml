<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 6-11 auto backup (android:fullBackupContent): nothing of this app may be backed up.
  allowBackup is already false; this file makes the exclusion explicit for every data domain, so the
  diary files (files/diary/*.mpd), device.key and the preferences never reach Google's cloud backup.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
