{
  "name": "your-personal-diary",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Your Personal Diary - a smart, private, encrypted personal diary: Windows (Tauri), Android (Capacitor) and web clients of one hosted Node.js server",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "server:dev": "npm --prefix server run dev",
    "server:test": "npm --prefix server test",
    "server:typecheck": "npm --prefix server run typecheck",
    "server:build": "node scripts/build-server.mjs",
    "sidecar:prepare": "node scripts/prepare-sidecar.mjs",
    "tauri": "tauri",
    "tauri:dev": "npm run server:build && npm run sidecar:prepare && tauri dev",
    "tauri:build": "npm run server:build && npm run sidecar:prepare && tauri build",
    "check:all": "npm run typecheck && npm run server:typecheck && npm run mobile:typecheck && npm test && npm run server:test && npm run mobile:test",
    "check:no-network": "node scripts/check-no-network.mjs",
    "mobile:dev": "vite -c mobile/vite.config.mobile.ts --port 1430 --strictPort",
    "mobile:build": "vite build -c mobile/vite.config.mobile.ts",
    "mobile:typecheck": "tsc --noEmit -p mobile/tsconfig.json",
    "mobile:test": "vitest run -c mobile/vitest.config.ts",
    "android:sync": "cap sync android",
    "android:doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android/doctor.ps1",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android/build-apk.ps1",
    "android:aab": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android/build-aab.ps1",
    "android:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android/verify-apk.ps1",
    "android:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android/install-phone.ps1",
    "android:bump": "node scripts/android/bump-version.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "date-fns": "^4.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/cli": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.0",
    "@types/path-browserify": "1.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "buffer": "6.0.3",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^30.0.1",
    "path-browserify": "1.0.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.0"
  }
}
