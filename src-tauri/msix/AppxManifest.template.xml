<?xml version="1.0" encoding="utf-8"?>
<!--
  Package manifest template of the Microsoft Store (MSIX) package of "Your Personal Diary".

  scripts/store/build-msix.mjs replaces the {{PLACEHOLDERS}} and writes the result as
  AppxManifest.xml into the package. Do not put real identity values here: they come from
  store/identity.json (see store/identity.example.json).

    {{IDENTITY_NAME}}            Partner Center: Package/Identity/Name
    {{PUBLISHER}}                Partner Center: Package/Identity/Publisher ("CN=...")
    {{PUBLISHER_DISPLAY_NAME}}   Partner Center: Package/Properties/PublisherDisplayName
    {{VERSION}}                  src-tauri/msix/package-version.json (four parts, the last one 0)
    {{DISPLAY_NAME}}             the name reserved in Partner Center ("Your Personal Diary")
    {{DESCRIPTION}}              short description (tauri.conf.json bundle.shortDescription)
    {{RESOURCE_LANGUAGES}}       one <Resource Language="..."/> per UI language (20), en-US first

  The application is a full-trust Win32 desktop app: the Tauri shell with WebView2, a server-only
  thin client of the Your Personal Diary server (no local server, no sidecar). The only capability
  is runFullTrust; network capabilities apply to AppContainer apps only (store/MSIX-BUILD.md,
  section 4c).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="{{IDENTITY_NAME}}"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>{{DISPLAY_NAME}}</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Resources>
{{RESOURCE_LANGUAGES}}
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Applications>
    <Application
      Id="YourPersonalDiary"
      Executable="your-personal-diary.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="{{DISPLAY_NAME}}"
        Description="{{DESCRIPTION}}"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
