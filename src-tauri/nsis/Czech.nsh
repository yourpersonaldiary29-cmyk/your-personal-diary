; Your Personal Diary - installer messages in Czech (Tauri NSIS LangStrings). UTF-8 without BOM.
LangString addOrReinstall ${LANG_CZECH} "Přidat/přeinstalovat součásti"
LangString alreadyInstalled ${LANG_CZECH} "Již nainstalováno"
LangString alreadyInstalledLong ${LANG_CZECH} "${PRODUCTNAME} ${VERSION} je již nainstalován. Vyberte požadovanou operaci a pokračujte kliknutím na Další."
LangString appRunning ${LANG_CZECH} "{{product_name}} je spuštěn! Nejprve jej zavřete a zkuste to znovu."
LangString appRunningOkKill ${LANG_CZECH} "{{product_name}} je spuštěn!$\nKliknutím na OK jej ukončíte"
LangString chooseMaintenanceOption ${LANG_CZECH} "Vyberte operaci údržby, kterou chcete provést."
LangString choowHowToInstall ${LANG_CZECH} "Vyberte, jak chcete nainstalovat ${PRODUCTNAME}."
LangString createDesktop ${LANG_CZECH} "Vytvořit zástupce na ploše"
LangString dontUninstall ${LANG_CZECH} "Neodinstalovat"
LangString dontUninstallDowngrade ${LANG_CZECH} "Neodinstalovat (instalace starší verze bez odinstalace není v tomto instalačním programu povolena)"
LangString failedToKillApp ${LANG_CZECH} "{{product_name}} se nepodařilo ukončit. Nejprve jej zavřete a zkuste to znovu"
LangString installingWebview2 ${LANG_CZECH} "Instaluje se WebView2..."
LangString newerVersionInstalled ${LANG_CZECH} "Novější verze ${PRODUCTNAME} je již nainstalována! Instalace starší verze se nedoporučuje. Pokud opravdu chcete nainstalovat tuto starší verzi, je lepší nejprve odinstalovat aktuální verzi. Vyberte požadovanou operaci a pokračujte kliknutím na Další."
LangString older ${LANG_CZECH} "starší"
LangString olderOrUnknownVersionInstalled ${LANG_CZECH} "V systému je nainstalována $R4 verze ${PRODUCTNAME}. Před instalací se doporučuje aktuální verzi odinstalovat. Vyberte požadovanou operaci a pokračujte kliknutím na Další."
LangString silentDowngrades ${LANG_CZECH} "Instalace starší verze není v tomto instalačním programu povolena, a proto nelze pokračovat v tiché instalaci. Použijte instalační program s grafickým rozhraním.$\n"
LangString unableToUninstall ${LANG_CZECH} "Odinstalace se nezdařila!"
LangString uninstallApp ${LANG_CZECH} "Odinstalovat ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_CZECH} "Před instalací odinstalovat"
LangString unknown ${LANG_CZECH} "neznámá"
LangString webview2AbortError ${LANG_CZECH} "Instalace WebView2 se nezdařila! Aplikace bez něj nemůže běžet. Zkuste instalační program spustit znovu."
LangString webview2DownloadError ${LANG_CZECH} "Chyba: Stažení WebView2 se nezdařilo - $0"
LangString webview2DownloadSuccess ${LANG_CZECH} "Zaváděcí program WebView2 byl úspěšně stažen"
LangString webview2Downloading ${LANG_CZECH} "Stahuje se zaváděcí program WebView2..."
LangString webview2InstallError ${LANG_CZECH} "Chyba: Instalace WebView2 selhala s návratovým kódem $1"
LangString webview2InstallSuccess ${LANG_CZECH} "WebView2 byl úspěšně nainstalován"
LangString deleteAppData ${LANG_CZECH} "Odstranit data aplikace (šifrovaný deník a účty)"
