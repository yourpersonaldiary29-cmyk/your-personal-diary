; Your Personal Diary - installer messages in Hindi (Tauri NSIS LangStrings). UTF-8 without BOM.
LangString addOrReinstall ${LANG_HINDI} "घटक जोड़ें/फिर से इंस्टॉल करें"
LangString alreadyInstalled ${LANG_HINDI} "पहले से इंस्टॉल है"
LangString alreadyInstalledLong ${LANG_HINDI} "${PRODUCTNAME} ${VERSION} पहले से इंस्टॉल है। आप जो कार्य करना चाहते हैं उसे चुनें और जारी रखने के लिए आगे पर क्लिक करें।"
LangString appRunning ${LANG_HINDI} "{{product_name}} चल रहा है! कृपया पहले इसे बंद करें और फिर से प्रयास करें।"
LangString appRunningOkKill ${LANG_HINDI} "{{product_name}} चल रहा है!$\nइसे बंद करने के लिए OK पर क्लिक करें"
LangString chooseMaintenanceOption ${LANG_HINDI} "करने के लिए रखरखाव विकल्प चुनें।"
LangString choowHowToInstall ${LANG_HINDI} "चुनें कि आप ${PRODUCTNAME} को कैसे इंस्टॉल करना चाहते हैं।"
LangString createDesktop ${LANG_HINDI} "डेस्कटॉप शॉर्टकट बनाएं"
LangString dontUninstall ${LANG_HINDI} "अनइंस्टॉल न करें"
LangString dontUninstallDowngrade ${LANG_HINDI} "अनइंस्टॉल न करें (इस इंस्टॉलर में अनइंस्टॉल किए बिना पुराना संस्करण इंस्टॉल करने की अनुमति नहीं है)"
LangString failedToKillApp ${LANG_HINDI} "{{product_name}} को बंद नहीं किया जा सका। कृपया पहले इसे बंद करें और फिर से प्रयास करें"
LangString installingWebview2 ${LANG_HINDI} "WebView2 इंस्टॉल हो रहा है..."
LangString newerVersionInstalled ${LANG_HINDI} "${PRODUCTNAME} का एक नया संस्करण पहले से इंस्टॉल है! पुराना संस्करण इंस्टॉल करने की सलाह नहीं दी जाती। यदि आप सच में यह पुराना संस्करण इंस्टॉल करना चाहते हैं, तो बेहतर है कि पहले वर्तमान संस्करण को अनइंस्टॉल करें। आप जो कार्य करना चाहते हैं उसे चुनें और जारी रखने के लिए आगे पर क्लिक करें।"
LangString older ${LANG_HINDI} "पुराना"
LangString olderOrUnknownVersionInstalled ${LANG_HINDI} "आपके सिस्टम पर ${PRODUCTNAME} का एक $R4 संस्करण इंस्टॉल है। इंस्टॉल करने से पहले वर्तमान संस्करण को अनइंस्टॉल करने की सलाह दी जाती है। आप जो कार्य करना चाहते हैं उसे चुनें और जारी रखने के लिए आगे पर क्लिक करें।"
LangString silentDowngrades ${LANG_HINDI} "इस इंस्टॉलर में पुराना संस्करण इंस्टॉल करने की अनुमति नहीं है, इसलिए साइलेंट इंस्टॉलेशन जारी नहीं रखा जा सकता। कृपया ग्राफ़िकल इंस्टॉलर का उपयोग करें।$\n"
LangString unableToUninstall ${LANG_HINDI} "अनइंस्टॉल नहीं किया जा सका!"
LangString uninstallApp ${LANG_HINDI} "${PRODUCTNAME} को अनइंस्टॉल करें"
LangString uninstallBeforeInstalling ${LANG_HINDI} "इंस्टॉल करने से पहले अनइंस्टॉल करें"
LangString unknown ${LANG_HINDI} "अज्ञात"
LangString webview2AbortError ${LANG_HINDI} "WebView2 इंस्टॉल नहीं हो सका! इसके बिना ऐप नहीं चल सकता। इंस्टॉलर को फिर से शुरू करके देखें।"
LangString webview2DownloadError ${LANG_HINDI} "त्रुटि: WebView2 डाउनलोड नहीं हो सका - $0"
LangString webview2DownloadSuccess ${LANG_HINDI} "WebView2 बूटस्ट्रैपर सफलतापूर्वक डाउनलोड हो गया"
LangString webview2Downloading ${LANG_HINDI} "WebView2 बूटस्ट्रैपर डाउनलोड हो रहा है..."
LangString webview2InstallError ${LANG_HINDI} "त्रुटि: WebView2 इंस्टॉल नहीं हो सका (एग्ज़िट कोड $1)"
LangString webview2InstallSuccess ${LANG_HINDI} "WebView2 सफलतापूर्वक इंस्टॉल हो गया"
LangString deleteAppData ${LANG_HINDI} "ऐप्लिकेशन का डेटा हटाएं (एन्क्रिप्ट की गई डायरी और खाते)"
